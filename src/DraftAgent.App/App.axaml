<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DraftAgent.App.App"
             xmlns:local="using:DraftAgent.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    <Application.Resources>
        <local:ImageAssetPreviewConverter x:Key="ImageAssetPreviewConverter"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei" />
            <Setter Property="Background" Value="#0C0F14" />
            <Setter Property="Foreground" Value="#E7EAF0" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E7EAF0" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#8E98A8" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#1B2230" />
            <Setter Property="Foreground" Value="#E7EAF0" />
            <Setter Property="BorderBrush" Value="#2C3546" />
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.sceneCollapseButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#111722" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#3A1820" />
            <Setter Property="Foreground" Value="#FDA4AF" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#111722" />
            <Setter Property="Foreground" Value="#E7EAF0" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#111722" />
            <Setter Property="Foreground" Value="#E7EAF0" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="#111722" />
            <Setter Property="Foreground" Value="#E7EAF0" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#111722" />
            <Setter Property="Foreground" Value="#E7EAF0" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.shell">
            <Setter Property="Background" Value="#0C0F14" />
        </Style>
        <Style Selector="Border.appHeader">
            <Setter Property="Background" Value="#111722" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.exportPreflightPanel">
            <Setter Property="Background" Value="#1C1824" />
            <Setter Property="BorderBrush" Value="#6D5A2B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#121824" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.layoutPanel">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.sectionHeader">
            <Setter Property="Background" Value="#121824" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.scriptCanvas">
            <Setter Property="Background" Value="#0F1520" />
        </Style>
        <Style Selector="Border.workbenchCanvas">
            <Setter Property="Background" Value="#0F1520" />
        </Style>
        <Style Selector="ListBox.workbenchSceneList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.workbenchSceneList > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.workbenchSceneList > ListBoxItem:pointerover,
                         ListBox.workbenchSceneList > ListBoxItem:selected,
                         ListBox.workbenchSceneList > ListBoxItem:selected:pointerover,
                         ListBox.bindingTargetList > ListBoxItem:pointerover,
                         ListBox.bindingTargetList > ListBoxItem:selected,
                         ListBox.bindingTargetList > ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.workbenchSceneList > ListBoxItem:pointerover /template/ ContentPresenter,
                         ListBox.workbenchSceneList > ListBoxItem:selected /template/ ContentPresenter,
                         ListBox.workbenchSceneList > ListBoxItem:selected:pointerover /template/ ContentPresenter,
                         ListBox.bindingTargetList > ListBoxItem:pointerover /template/ ContentPresenter,
                         ListBox.bindingTargetList > ListBoxItem:selected /template/ ContentPresenter,
                         ListBox.bindingTargetList > ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.bindingTargetList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.bindingTargetList > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox.scriptEditor">
            <Setter Property="Background" Value="#0B111A" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Button.scriptTabClose">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#172033" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="#111722" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Background" Value="#0F1520" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="Border.sceneBlock">
            <Setter Property="Background" Value="#0F1520" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.referenceScene">
            <Setter Property="Background" Value="#0B111A" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.referenceSceneHeader">
            <Setter Property="Background" Value="#0B111A" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.sceneIndex">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Border.sceneThumb">
            <Setter Property="Background" Value="#0B111A" />
            <Setter Property="BorderBrush" Value="#2C3546" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.sceneDragHandle">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#111722" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.sceneDragHandle:pointerover">
