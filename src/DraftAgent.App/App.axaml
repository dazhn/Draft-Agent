            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style Selector="Button.sceneDragHandle TextBlock">
            <Setter Property="Foreground" Value="#8E98A8" />
        </Style>
        <Style Selector="Button.sceneDragHandle:pointerover TextBlock">
            <Setter Property="Foreground" Value="#D7E6FF" />
        </Style>
        <Style Selector="Button.sceneSquareButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#111722" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.sceneSquareButton:pointerover">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style Selector="Button.roundResetButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#111722" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.roundResetButton:pointerover">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style Selector="TextBox.sceneTitleInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.sceneEffectInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#B8C2D6" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Border.assetStrip">
            <Setter Property="Background" Value="#0F1520" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Border.tableHeader">
            <Setter Property="Background" Value="#101725" />
            <Setter Property="BorderBrush" Value="#263044" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Border.tableHeader TextBlock">
            <Setter Property="Foreground" Value="#8E98A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.tableRow">
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
        <Style Selector="Border.tableRow:pointerover">
            <Setter Property="Background" Value="#131B29" />
        </Style>
        <Style Selector="Border.eventTable">
            <Setter Property="Background" Value="#0B111A" />
        </Style>
        <Style Selector="Border.eventRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="20,0,0,6" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.eventRow > Grid">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.eventRow:pointerover">
            <Setter Property="Background" Value="#0F1724" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
        <Style Selector="Border.eventRow.selected">
            <Setter Property="Background" Value="#10213A" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style Selector="Border.eventRow.dragSourceActive">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="Transparent" />
